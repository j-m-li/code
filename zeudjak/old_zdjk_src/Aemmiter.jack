
class Aemmiter {
field string _data;
field Aprod prod;
field buffer _proc;
field buffer _stk;
field Atoken token1;
field Atoken token2;

constructor Aemmiter new()
{
	_proc := buffer.new(100);
	_stk := buffer.new(100);
	_data := string.new(1024);
	token1 := null;
	token2 := null;
	return this;
}

method void dispose()
{
	_proc.dispose();
	_stk.dispose();
	_data.dispose();
	std.free(this);
	return;
}

method int emmit(in Aparser par)
{
	prod := par.get_next();
	while (prod != null) {
		gen_func();
	//	prod.dispose();
		prod := par.get_next();
	}
	console.log(_data);
	return 1;
}

method void work_left(in linked c)
{
        var Atoken to;
       	to := c.get_data1();
       	_data.add(to.get_data());
	return;
}

method void call_ensure(in Atoken to)
{
       	_data.add("\tt := ");
       	_data.add(to.get_data());
	_data.add("(); if (t == 0) {error();}\n");
	return;
}

method void call_maybe(in Atoken to)
{
       	_data.add("\t");
       	_data.add(to.get_data());
	_data.add("();\n");
	return;
}

method void call_multi(in Atoken to)
{
       	_data.add("\tt := 1; while (t != 0) { t := ");
       	_data.add(to.get_data());
	_data.add("(); }\n");
	return;
}

method void call_test(in Atoken to)
{
       	_data.add("\tif (t == 0) {t := ");
       	_data.add(to.get_data());
	_data.add("();}\n");
	return;
}

method void end()
{
	if (token2 != null) {
		call_ensure(token2);
		token2 := null;
	}
	if (token1 != null) {
		call_ensure(token1);
		token1 := null;
	}
	return;
}

method void work(in linked c)
{
        var Atoken to, pt;
	var string s;
	var linked p;

       	to := c.get_data1();
	console.log_int(c);
	console.log("");
	if (to.get_type() == Alexer.$Coperator) {
		s := to.get_data();
		p := c.get_parent();
		if (s.compare("|") == 0) {
			if (token2 != 0) {
				call_test(token2);
			}
			call_test(token1);
			pt := p.get_data1();
			s := pt.get_data();
			if ((pt.get_type() == Alexer.$Coperator) && 
				(s.compare("|") == 0)) 
			{
				//
			} else {
				_data.add("\tif (t == 0) {\n");
				_data.add("\t\tif (trying == 1) {return 0;}\n");
				_data.add("\t\treturn error(");
				_data.add(");\n\t}\n"); // FIXME
				_data.add("\tadvance();\n"); // FIXME string
			}
		} else if (s.compare("*") == 0) {
			if (token2 != null) {
				call_ensure(token2);
			}
			call_multi(token1);
		} else if (s.compare("?") == 0) {
			if (token2 != null) {
				call_ensure(token2);
			}
			call_maybe(token1);
		}
		token1 := null;
		token2 := null;
	} else if (to.get_type() == Alexer.$Cstring) {
	} else {
		console.log(to.get_data());
		if (token2 != null) {
			call_ensure(token2);
			token2 := token1;
			token1 := to;
			return;
		} else if (token1 != null) {
			p := c.get_right();
			if (p != null) {
				pt := p.get_data1();
			} else {
				pt := null;
			}
			if (token1 == pt) {
				call_ensure(token1);
				token1 := null;
			} else {
				token2 := token1;
				token1 := to;
			}
		} else {
			token1 := to;
		} 
	}
	return;

}

method void error(in string e)
{
	console.log(e);
	dump();
	std.exit(-1);
	return;
}
	
method void dump()
{
	var linked c;
	var Atoken to;
	var string s;
	var int l;
	l := _proc.length();

	while (l > 0) {
		l := l - 1;
		c := _proc.get_at(l);
		to := c.get_data1();
		s := to.get_data();
		if (s != null) {
			console.log_int(c.get_flags());
			console.log(s);
		}
	}
	return;
}

method void gen()
{
	var linked c;
	var int cs;

	while (_proc.empty() == 0) {
		c := _proc.get_last();
		cs := c.get_flags();
		if (cs == 0) {
			if (deep_left(c) == 0) {
				if (deep_right(c) == 0) {
					c.set_flags(3);
					cs := 3;
				} else {
					c.set_flags(2);
				}
			} else {
				c.set_flags(1);
			}	
		} else if (cs == 1) {
			if (deep_right(c) == 0) {
				c.set_flags(3);
				cs := 3;
			} else {
				c.set_flags(2);
			}
		} else if (cs == 2) {
			//console.log_int(c.get_flags());		
			c.set_flags(3);
			cs := 3;
		}
		if (cs == 3) {
			c := _proc.pop();
			work(c);
			c.set_flags(4);
		} else if (cs > 3) {
			error("token seen twice...");
			return;
		}
	}
	end();
	return;
}

method void deep_right(in linked li) 
{
        var linked c;
	c := li.get_right();
	if (c != null) {
		_proc.push(c);
		//c.set_flags(2);
		//deep_left(c);
		return 1;
	}
	return 0;
}

	
method void deep_left(in linked li) 
{
        var linked c;
	var int r;
	r := 0;
	c := li.get_left();
	while (c != null) {
		r := 1;
		_proc.push(c);
		c.set_flags(1);
		c := c.get_left();
	}
	return r;
}

method void gen_func()
{
        var Atoken to;
	var Aterm child;

	//prod.dump(0);        
	//_data.set("");
        _data.add("\nmethod int ");
        to := prod.get_token();
        _data.add(to.get_data());
        _data.add("()\n{\n");
        _data.add("\tvar int r, t;\n");
        _data.add("\tr := 0;\n");
        _data.add("\tt := 0;\n");
	child := prod.get_child();
	if (child != null) {
		child.gen_func(0, _data, to, 0);
	}
        _data.add("\n\treturn r;\n}\n");
      return;
}

} // class
